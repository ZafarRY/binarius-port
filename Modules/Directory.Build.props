<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632;CS0618;CS0672;CS0612;CS0168;CS0219;CS0649;CS0169;CS0414;CS1591;CA1416;SYSLIB0011;SYSLIB0051</NoWarn>
  </PropertyGroup>
</Project>